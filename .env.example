# 복사해서 .env로 만들고 값을 채운다. (.env는 git에 올리지 않는다)
GOOGLE_API_KEY=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag
# DATABASE_URL을 직접 지정하면 위 값 대신 사용한다.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/rag

# 임베딩 모델과 차원 (실험 시작 전에 하나로 고정)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
